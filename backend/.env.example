
# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/notegenius
MONGOURI=

# JWT Authentication
JWT_ACCESS=replace_with_access_token_secret
JWT_REFRESH=replace_with_refresh_token_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173

# Disk STORAGE UPLOAD PATH
UPLOAD_PATHS=your_upload_path

# Gemini API KEYS
GEMINI_API_KEY=your_generated_key
GEMINI_PROJECT_NAME=your_project_name
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=3072
GEMINI_BASE_URL=

# Web Context
TAVILY_KEY=your_generated_tavily_key

# AWS / BLOB STORAGE KEY
AWS_S3_KEY=aws_s3_access_key
AWS_S3_SECRET_KEY=secret_key
AWS_S3_BUCKET=bucket_name
AWS_S3_REGION=aws_s3_region
AWS_S3_ARN=aws_s3_resource_name

# RATE LIMITING CONFIGURATION
RATE_LIMIT_APP_WINDOW_SECONDS=60
RATE_LIMIT_APP_MAX_REQUESTS=100

RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=10

RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX_REQUESTS=5

RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AI_MAX_REQUESTS=5

RATE_LIMIT_CONVERSATION_WINDOW_SECONDS=60
RATE_LIMIT_CONVERSATION_MAX_REQUESTS=10

RATE_LIMIT_RETRIEVAL_WINDOW_SECONDS=60
RATE_LIMIT_RETRIEVAL_MAX_REQUESTS=60

RATE_LIMIT_ANSWER_WINDOW_SECONDS=60
RATE_LIMIT_ANSWER_MAX_REQUESTS=60

RATE_LIMIT_SHARING_WINDOW_SECONDS=60
RATE_LIMIT_SHARING_MAX_REQUESTS=20

RATE_LIMIT_PROFILE_WINDOW_SECONDS=60
RATE_LIMIT_PROFILE_MAX_REQUESTS=20